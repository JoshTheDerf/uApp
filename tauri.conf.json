{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UApp",
  "mainBinaryName": "uapp",
  "identifier": "com.thederf.uapp",
  "build": {
    "frontendDist": "src/shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "uapp"
        ],
        "name": "UApp application",
        "description": "UApp shareable application",
        "role": "Editor",
        "mimeType": "application/x-uapp"
      }
    ],
    "macOS": {
      "infoPlist": "installer/macos/Info.plist"
    },
    "category": "Utility",
    "linux": {
      "deb": {
        "desktopTemplate": "installer/linux/uapp.desktop",
        "files": {
          "/usr/share/mime/packages/uapp.xml": "installer/linux/uapp-mime.xml",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-uapp.svg": "assets/icon-file.svg"
        }
      },
      "rpm": {
        "desktopTemplate": "installer/linux/uapp.desktop",
        "files": {
          "/usr/share/mime/packages/uapp.xml": "installer/linux/uapp-mime.xml",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-uapp.svg": "assets/icon-file.svg"
        }
      }
    }
  }
}
