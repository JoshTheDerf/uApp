# uapp hosting image — `uapp-server serve` (one .uapp as a website, or the
# bare browser build) and `uapp-library` (a directory of .uapp files).
#
# Site mode serves ONE .uapp as a website: rendered pages under `app/` at real
# URLs for everyone; the shell, the WebSocket and publishing (PUT /site.uapp)
# only with the token (see src/server.rs). The .uapp itself is NOT baked into
# the image; it is bind-mounted under /site so content updates are a publish
# from the browser (or an rsync + restart), not a rebuild.
#
#   docker build -f Dockerfile.serve -t uapp-serve .
#   docker run -v /path/to/sitedir:/site -v /path/to/dist-web:/opt/uapp-web:ro \
#              -e UAPP_TOKEN=... -p 8080:8080 uapp-serve
#
# Web-host mode (no archive; the page opens what its URL names, see
# src/webhost.rs) — unset UAPP_SITE and give a default:
#   docker run -v /path/to/dist-web:/opt/uapp-web:ro -e UAPP_SITE= \
#              -e UAPP_SERVE_FLAGS="--open /uapp/apps/launcher.uapp" uapp-serve
#
# Library (src/library.rs): override the command, and set UAPP_PORT to its
# port so the health check probes the right one:
#   docker run -v /path/to/apps:/apps -e UAPP_TOKEN=... -e UAPP_PORT=8090 \
#              uapp-serve sh -c 'exec uapp-library /apps --bind 0.0.0.0 --port "$UAPP_PORT"'
#
# The mounts must be writable by the container user for publishing to work
# (run with --user <uid> of the files' owner, or chown them); a read-only mount
# still serves, and a publish is refused with an error.

FROM rust:1-trixie AS build
WORKDIR /src

# rusqlite's `bundled-sqlcipher-vendored-openssl` compiles SQLCipher AND
# OpenSSL from source, so the build needs perl + make on top of the toolchain.
RUN apt-get update \
 && apt-get install -y --no-install-recommends perl make pkg-config \
 && rm -rf /var/lib/apt/lists/*

# Only what the crate compiles from. dist-web/ is deliberately NOT here: it is
# copied straight into the runtime stage below, so a browser-build-only change
# (site-chrome.js, boot.js, sw.js) never invalidates this ~13-minute layer.
# --no-default-features drops the `gui` feature (Tauri + a system webview),
# which a headless server image has no use for and cannot link anyway.
COPY Cargo.toml Cargo.lock build.rs tauri.conf.json ./
COPY src ./src
COPY assets ./assets
COPY capabilities ./capabilities
COPY templates ./templates
RUN cargo build --release --bin uapp-server --bin uapp-library --no-default-features

# --- runtime image ---
# The binary links only libc/libm/libgcc (SQLite, SQLCipher and OpenSSL are all
# statically linked in), so a bare slim image is enough.
FROM debian:trixie-slim
WORKDIR /site

RUN useradd --system --uid 10001 --no-create-home uapp
COPY --from=build /src/target/release/uapp-server /usr/local/bin/uapp-server
COPY --from=build /src/target/release/uapp-library /usr/local/bin/uapp-library
# The browser build (wasm engine + shell) behind `--chrome` is NOT in the
# image: bind-mount dist-web at /opt/uapp-web (read-only is fine). One rsync
# then updates every container that serves it; restart them to pick it up.
# Build it with scripts/build-web.sh (needs clang + wasm-bindgen).
RUN mkdir -p /opt/uapp-web

# The engine keeps its per-user state (crash-rescue snapshots, the registry
# lock, and an API key or MCP credentials moved out of the served file, see
# src/secrets.rs) under HOME; world-writable so `--user <any uid>` works too.
# Mount a volume here if any of that should outlive the container.
RUN mkdir -p /var/lib/uapp && chmod 1777 /var/lib/uapp
ENV HOME=/var/lib/uapp
# An unprivileged user means a bug can't reach anything but the site.
USER uapp

# The archive to serve. Empty = web-host mode (the browser build alone).
ENV UAPP_SITE=/site/site.uapp
ENV UAPP_PORT=8080
# UAPP_TOKEN: the publish secret (`--token`). Unset = a random one per start,
# printed to the log — fine for a read-mostly site, useless for publishing.
EXPOSE 8080

# `docker stop` sends SIGTERM, which the servers handle (cleanup, then exit),
# so the sh below execs them as PID 1 rather than staying in between.
#
# Defaults suit a hosted site that wants the in-browser editor:
#   --chrome        serve the browser build, enabling the "Edit this site" pill.
#   --coi           COOP/COEP on documents, so the editor is cross-origin
#                   isolated with no reload and the AI's run_js bridge works.
#                   Drop it if the site embeds cross-origin iframes.
# Not on by default: --publish-data, which ships data/ (content sources)
# inside the PUBLIC /site.uapp so a visitor can re-run the site's build
# pipeline. Opt in with UAPP_SERVE_FLAGS="--publish-data --coi".
CMD ["sh", "-c", "exec uapp-server serve $UAPP_SITE --bind 0.0.0.0 --port \"$UAPP_PORT\" --chrome /opt/uapp-web ${UAPP_SERVE_FLAGS-${UAPP_SITE:+--coi}}"]

# /health answers in every mode (site, web host, library). No curl in the
# slim image, so bash's /dev/tcp makes the request.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/${UAPP_PORT:-8080} && printf 'GET /health HTTP/1.0\\r\\nHost: 127.0.0.1\\r\\n\\r\\n' >&3 && head -n1 <&3 | grep -q ' 200 '"]
